# Recommended: set the key directly in your hosting panel.
STEAM_WEB_API_KEY=your_steam_web_api_key_here

# Optional encrypted mode:
# STEAM_WEB_API_KEY_ENCRYPTED=ssg1:...
# STEAM_KEY_SECRET=long_random_secret_used_only_on_the_server

PORT=5177
APP_BASE_URL=https://your-domain.example

# Abuse protection defaults.
RATE_LIMIT_IP_HOUR=5000
RATE_LIMIT_IP_DAY=20000
RATE_LIMIT_GLOBAL_DAY=50000
RATE_LIMIT_GLOBAL_MONTH=100000
MAX_EXPORT_GAMES=1000
EXPORT_JOB_TTL_MS=1200000
STEAM_TIMEOUT_MS=15000
STORE_CACHE_TTL_MS=86400000
